# Same bytes on every computer: each run's history file stores the SHA-256 of common.py, models.py and
# runs.py, which only matches with Unix line endings.
* text=auto eol=lf
*.pt binary
*.png binary
# fusion.py's tables are kept byte for byte as it wrote them: their SHA-256 is in fusion_<graph>_ft_inputs.json
results/fusion/*.csv -text
